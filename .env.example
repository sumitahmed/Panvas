# Panvas Environment Variables Template
# Copy this file to .env and fill in your values for local development.
# Do NOT commit your actual .env file.

# Optional account integration. Local editing requires no account or keys.
# Only a public anon/publishable key belongs in VITE_ variables; never service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional analytics; disabled below and restricted to marketing-only builds.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Deployment Modes
# Set to 'true' to disable the workspace application and route everything to the Private Beta page.
VITE_MARKETING_ONLY=false

# Release-gated network capabilities. Both default to disabled.
VITE_ENABLE_CLOUD_SYNC=false
# Uses the isolated Panvas/sync-v2 namespace and V2-only local baseline state.
VITE_PANVAS_SYNC_V2=false

# Public OAuth Web client ID for browser/PWA Google Drive sync. This is not a
# client secret. Add the deployed/dev origins to the client's authorized
# JavaScript origins in the same Google Cloud project as the desktop client.
VITE_PANVAS_GOOGLE_WEB_CLIENT_ID=

# Electron main-process-only Desktop OAuth client. These values are never
# exposed through Vite's renderer environment.
PANVAS_GOOGLE_CLIENT_ID=
PANVAS_GOOGLE_CLIENT_SECRET=
# Analytics is additionally restricted to marketing-only builds.
VITE_ENABLE_ANALYTICS=false

# Discord Rich Presence (Desktop / Electron only).
# Local IPC client: uses Application ID and asset key ONLY (no secrets, bots, or OAuth).
PANVAS_DISCORD_APPLICATION_ID=1546879865997758576
PANVAS_DISCORD_ASSET_KEY=panvas-logo_1

# Docker web server (loopback by default; use TLS reverse proxy for remote access).
PANVAS_BIND_ADDRESS=127.0.0.1
PANVAS_WEB_PORT=8080
PANVAS_DEV_PORT=3000
# Public build identifier shown in About; no credentials or private path.
VITE_PANVAS_BUILD_ID=local

